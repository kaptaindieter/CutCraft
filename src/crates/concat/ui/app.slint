import { I18n } from "i18n.slint";
import "../../concat-text/fonts/HankenGrotesk-Regular.ttf";
import "../../concat-text/fonts/HankenGrotesk-Medium.ttf";
import "../../concat-text/fonts/HankenGrotesk-SemiBold.ttf";
import "../../concat-text/fonts/HankenGrotesk-Bold.ttf";
import "../../concat-text/fonts/HankenGrotesk-Italic.ttf";

import { Theme } from "theme/theme.slint";
import {
    AiMessageItem,
    AiModelItem,
    AiSidebar,
    ApiManagerModal,
    Craft,
    CraftFooter,
    FooterThemePopover,
} from "craft.slint";
import { Bezier, Curves, Fmt, Focus, Payload } from "util.slint";
import { EffectData } from "demo/effects-panel.slint";
import {
    MediaFilter,
    MediaItemData,
    MediaKind,
    SourcePreview,
    TextPresetData,
} from "workspace/media-pane.slint";
import {
    SoundCardData,
    Sounds,
    VoiceCardData,
} from "workspace/audio-page.slint";
import {
    ContextMenu,
    MenuItemData,
    MenuRow,
} from "primitives/context-menu.slint";
import { ExportData, ExportDialog, ExportPhase } from "dialogs/export.slint";
import {
    ModelData,
    SettingsData,
    SettingsDialog,
    SystemFactData,
} from "dialogs/settings.slint";
import { ProjectDialog, ProjectSheetData } from "dialogs/project.slint";
import {
    RelinkDialog,
    RelinkData,
    MissingMediaItem,
} from "dialogs/relink.slint";
import { ConfirmData, ConfirmDialog } from "dialogs/confirm.slint";
import { CaptionsDialog, CaptionsSheetData } from "dialogs/captions.slint";
import { SpeechDialog, SpeechSheetData } from "dialogs/speech.slint";
import { NewVoiceData, NewVoiceDialog } from "dialogs/new-voice.slint";
import { AvatarData } from "primitives/avatar.slint";
import { VoiceoverData, VoiceoverPanel } from "dialogs/voiceover.slint";
import { DockDivider, DockSide, SeatBox } from "dock.slint";
import { Editor } from "editor.slint";
import { PaneKind, Panes } from "workspace/pane-switcher.slint";
import {
    ChipOption,
    NewProjectDialog,
    RecentProjectData,
    StartData,
    StartScreen,
} from "start.slint";
import { TitleBar } from "title-bar.slint";
import { PhoneEditor, PhoneSheets } from "phone/editor.slint";
import {
    AppliedEntryData,
    AppliedParamData,
    CatalogueEntryData,
    Library,
    LibraryViewData,
    ChainChoiceData,
    TransitionChoiceData,
} from "inspector/clip-inspector.slint";
import { ParamFormat } from "inspector/controls.slint";
import { ToastData, ToastLayer } from "primitives/toast.slint";
import { TooltipLayer } from "primitives/tooltip.slint";
import { FontSearch } from "inspector/font-picker.slint";
import { Meters } from "timeline/vu-meter.slint";
import { Workspace } from "workspace/workspace.slint";
import {
    Backdrop,
    BackdropData,
    ClipData,
    ClipField,
    ClipKeyData,
    ClipKind,
    ClipTextField,
    DropData,
    Keyframes,
    SelectedClipData,
    SelectedTransitionData,
    StageGuideData,
    StageItemData,
    TextAlignment,
    TimelineTabData,
    TimelineTool,
    TrackData,
    TrackSize,
} from "timeline/model.slint";

import {
    KeyEditor,
    KeyMarkData,
    KeyRowData,
} from "workspace/keyframes-pane.slint";
import { SpeedRamp } from "inspector/speed-ramp.slint";

export {
    AiMessageItem,
    AiModelItem,
    Craft,
    Curves,
    Fmt,
    Focus,
    Payload,
    Theme,
    Bezier,
    Editor,
    I18n,
    AppliedEntryData,
    AppliedParamData,
    CatalogueEntryData,
    Library,
    LibraryViewData,
    ParamFormat,
    ChainChoiceData,
    TransitionChoiceData,
    DockDivider,
    DockSide,
    PaneKind,
    SeatBox,
    EffectData,
    FontSearch,
    Meters,
    MediaFilter,
    MediaItemData,
    MediaKind,
    SourcePreview,
    TextPresetData,
    Backdrop,
    BackdropData,
    ClipData,
    ClipField,
    ClipKeyData,
    ClipKind,
    ClipTextField,
    DropData,
    Keyframes,
    KeyEditor,
    KeyMarkData,
    KeyRowData,
    SpeedRamp,
    SelectedClipData,
    SelectedTransitionData,
    StageGuideData,
    StageItemData,
    TextAlignment,
    TimelineTabData,
    TimelineTool,
    TrackData,
    TrackSize,
    MenuItemData,
    MenuRow,
    ExportData,
    ExportPhase,
    ModelData,
    SettingsData,
    ChipOption,
    RecentProjectData,
    StartData,
    SystemFactData,
    ToastData,
    ProjectSheetData,
    CaptionsSheetData,
    SpeechSheetData,
    VoiceoverData,
    SoundCardData,
    Sounds,
    VoiceCardData,
    NewVoiceData,
}

export component App inherits Window {
    title: "CutCraft";
    icon: @image-url("../../../../assets/icons/concat_logo_256.png");
    no-frame: root.own-window-buttons && !root.phone;
    background: Theme.page;
    default-font-family: Theme.font;
    default-font-size: Theme.fs;
    default-font-weight: Theme.weight-body;
    preferred-width: root.phone ? 420px : 1400px;
    preferred-height: root.phone ? 880px : 900px;
    min-width: root.phone ? 320px : 900px;
    min-height: root.phone ? 480px : 560px;
    forward-focus: keys;

    changed on-start => {
        if (!root.on-start) {
            keys.focus();
        }
    }
    property <bool> sheet-open: root.export.open || root.settings.open
        || root.project-sheet.open || root.captions.open || root.speech.open
        || root.start.composing || root.new-voice.open || Craft.api-modal-open;
    changed sheet-open => {
        if (!root.sheet-open) {
            keys.focus();
        }
    }

    in property <bool> on-start: true;
    in property <StartData> start;
    in property <[ChipOption]> start-aspects;
    in property <[ChipOption]> start-sizes;
    in property <[ChipOption]> start-rates;
    in property <[RecentProjectData]> recents;

    callback start-compose();
    callback start-dismiss();
    callback start-name-edited(name: string);
    callback start-location-edited(path: string);
    callback start-browse();
    callback start-aspect-changed(index: int);
    callback start-size-changed(index: int);
    callback start-rate-changed(index: int);
    callback start-custom-width-edited(width: float);
    callback start-custom-height-edited(height: float);
    callback start-custom-fps-edited(fps: float);
    callback start-canvas-changed(value: color);
    callback start-create();
    callback start-open();
    callback start-open-recent(path: string);
    callback start-forget-recent(path: string);
    callback start-reveal-recent(path: string);
    callback start-search-edited(query: string);
    callback start-sort-changed(sort: int);
    callback start-link(name: string);
    callback start-dismiss-error();
    in property <int> recents-total;
    in property <string> app-version;
    in property <bool> can-drop;

    in property <string> project-name: I18n.t("common.untitledProject");
    in property <string> project-status: I18n.t("common.saved");
    in property <bool> macos;
    in property <bool> phone;
    property <bool> sheets-fill: root.phone || root.width < 600px;
    property <string> front-tool: "captions";

    in property <int> open-menu: -1;
    in property <[MenuItemData]> app-menu-items;
    in property <length> app-menu-height;
    in property <int> app-menu-token;
    callback menu-opened(index: int);
    callback app-menu-selected(id: string);

    callback titlebar-begin-drag();
    callback titlebar-toggle-maximize();
    callback titlebar-minimize();
    callback titlebar-close();
    in property <bool> own-window-buttons;
    in-out property <bool> window-maximized;
    callback window-resized();
    changed width => { root.window-resized(); }
    changed height => {
        Panes.window-height = self.height;
        root.window-resized();
    }
    init => { Panes.window-height = self.height; }

    in property <ExportData> export;
    in property <SettingsData> settings;
    in property <[ModelData]> transcribers;
    in property <[ModelData]> voices;
    in property <[string]> versions;
    in property <[string]> version-details;
    in property <[string]> languages;
    in property <[SystemFactData]> system-facts;
    in property <string> system-report;

    callback export-closed();
    callback export-name-edited(name: string);
    callback export-browse();
    callback export-rate-changed(index: int);
    callback export-codec-changed(index: int);
    callback export-ten-bit-changed(on: bool);
    callback export-hdr-changed(on: bool);
    callback export-bitrate-changed(mbps: float);
    callback export-start();
    callback export-cancel();
    callback export-reveal();
    callback export-again();

    callback settings-closed();
    callback settings-page-changed(index: int);
    callback settings-show-log();
    callback settings-language-changed(index: int);
    callback settings-log-level-changed(index: int);
    callback settings-theme-changed(dark: bool);
    callback settings-accent-changed(index: int);
    callback settings-accent-custom-changed(colour: color);
    callback settings-playhead-changed(colour: color);
    callback settings-playhead-chosen(index: int);
    callback settings-scale-changed(index: int);
    callback settings-playhead-stops-changed(on: bool);
    callback settings-proxies-changed(on: bool);
    callback settings-gpu-changed(on: bool);
    callback settings-magnetic-changed(on: bool);
    callback settings-download-source-changed(index: int);
    callback settings-download-base-edited(text: string);
    callback settings-server-enabled-changed(on: bool);
    callback settings-server-host-edited(text: string);
    callback settings-server-port-edited(port: int);
    callback settings-server-token-edited(text: string);
    callback settings-server-token-generated();
    callback settings-check-updates();
    callback settings-version-chosen(index: int);
    callback settings-install-version();
    callback settings-install-cancel();
    callback settings-shortcut-capture(id: string);
    callback settings-shortcut-reset(id: string);
    callback settings-shortcut-reset-all();
    callback model-activated(id: string);
    callback model-download(id: string);
    callback model-cancel(id: string);
    callback model-remove(id: string);
    callback model-open-link(id: string);
    callback model-choose-file(id: string);

    callback open-settings();
    callback export-clicked();

    in property <ProjectSheetData> project-sheet;
    callback project-closed();
    callback project-name-edited(name: string);
    callback project-size-changed(index: int);
    callback project-rate-changed(index: int);
    callback project-custom-width-edited(width: float);
    callback project-custom-height-edited(height: float);
    callback project-custom-fps-edited(fps: float);
    callback project-color-space-changed(index: int);
    callback project-canvas-changed(value: color);
    callback project-apply();

    in property <CaptionsSheetData> captions;
    in property <[string]> caption-models;
    in property <[string]> caption-languages;
    callback captions-closed();
    callback captions-voice-toggled(on: bool);
    callback captions-source-changed(index: int);
    callback captions-text-edited(text: string);
    callback captions-model-changed(index: int);
    callback captions-language-changed(index: int);
    callback captions-placement-changed(index: int);
    callback captions-size-changed(index: int);
    callback captions-begin();
    callback captions-cancel();
    callback captions-import-srt();
    callback captions-export-srt();

    in property <SpeechSheetData> speech;
    in property <[string]> speech-models;
    in property <[string]> speech-model-details;
    in property <[string]> speech-voices;
    in property <[string]> speech-voice-details;
    in property <[AvatarData]> speech-voice-avatars;
    in property <[string]> speech-samples;
    in property <[string]> speech-sample-waves;
    in property <[string]> speech-sample-details;
    callback speech-closed();
    callback speech-text-edited(text: string);
    callback speech-voice-changed(index: int);
    callback speech-model-changed(index: int);
    callback speech-speed-changed(value: float);
    callback speech-quality-changed(index: int);
    callback speech-pauses-changed(value: float);
    callback speech-reference-start-changed(seconds: float);
    callback speech-use-sample-changed(on: bool);
    callback speech-sample-changed(index: int);
    pure callback speech-insert-tag(text: string, tag: string, at: int) -> string;
    callback speech-begin();
    callback speech-cancel();
    callback speech-save-name-edited(name: string);
    callback speech-pick-picture();
    callback speech-save-voice();
    callback speech-clear-style();

    in property <NewVoiceData> new-voice;
    callback new-voice-closed();
    callback new-voice-name-edited(name: string);
    callback new-voice-description-edited(text: string);
    callback new-voice-start-changed(seconds: float);
    callback new-voice-pick-picture();
    callback new-voice-save();

    in property <VoiceoverData> voiceover;
    in property <[string]> voiceover-devices;
    callback voiceover-closed();
    callback voiceover-action(verb: string);
    callback voiceover-device-changed(index: int);
    callback voiceover-countdown-changed(on: bool);
    callback voiceover-mute-changed(on: bool);
    callback voiceover-gain-changed(db: float);
    callback voiceover-prompt-edited(text: string);
    callback voiceover-prompt-speed-changed(index: int);

    public function blur() {
        keys.focus();
    }

    property <int> keyboard-menu: -1;
    property <int> keyboard-menu-token;
    property <bool> menu-by-keyboard;
    function open-menu-from-keys(index: int) {
        root.keyboard-menu = index;
        root.keyboard-menu-token += 1;
    }

    in property <ToastData> toast;

    callback meter-watched-changed(watched: bool);
    changed meter-watched => {
        root.meter-watched-changed(root.meter-watched);
    }
    out property <bool> meter-watched;
    out property <bool> muted;

    keys := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;

        KeyBinding {
            keys: @keys(F10);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(0); }
        }

        KeyBinding {
            keys: @keys(Alt + F);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(0); }
        }

        KeyBinding {
            keys: @keys(Alt + E);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(1); }
        }

        KeyBinding {
            keys: @keys(Alt + V);
            enabled: !root.on-start && !root.macos && !root.phone;
            activated => { root.open-menu-from-keys(2); }
        }

        KeyBinding {
            keys: @keys(Control + O);
            activated => { root.app-menu-selected("open"); }
        }

        KeyBinding {
            keys: @keys(Control + W);
            enabled: root.macos || !root.on-start;
            activated => {
                root.app-menu-selected(root.macos ? "close-window" : "close-project");
            }
        }

        KeyBinding {
            keys: @keys(Control + Q);
            enabled: !root.macos;
            activated => { root.app-menu-selected("close-window"); }
        }

        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Back) {
                if (Craft.api-modal-open) { Craft.close-api-modal(); return accept; }
                if (Craft.footer-theme-open) { Craft.footer-theme-open = false; return accept; }
                if (Craft.model-popover-open) { Craft.model-popover-open = false; return accept; }
                if (root.confirm.open) { root.confirm-dismissed(); return accept; }
                if (root.relink.open) { root.relink-dismiss(); return accept; }
                if (root.new-voice.open) {
                    if (!root.new-voice.saving) { root.new-voice-closed(); }
                    return accept;
                }
                if (root.project-sheet.open) { root.project-closed(); return accept; }
                if (root.settings.open) { root.settings-closed(); return accept; }
                if (root.export.open) {
                    if (root.export.phase != ExportPhase.running) { root.export-closed(); }
                    return accept;
                }
                if (root.start.composing) {
                    if (!root.start.busy) { root.start-dismiss(); }
                    return accept;
                }
                if (root.speech.open && (root.front-tool == "speech" || !root.captions.open)) {
                    if (!root.sheets-fill || !root.speech.running) { root.speech-closed(); }
                    return accept;
                }
                if (root.captions.open) {
                    if (!root.sheets-fill || !root.captions.running) { root.captions-closed(); }
                    return accept;
                }
                if (Editor.library-audition != "") {
                    Editor.library-audition-filter(Editor.library-audition);
                    return accept;
                }
            }
            if ((event.text == Key.Back || event.text == Key.Escape) && root.phone && PhoneSheets.open) {
                PhoneSheets.close-asked += 1;
                return accept;
            }
            if (event.text == Key.Back) {
                if (!root.on-start) {
                    root.app-menu-selected("close-project");
                    return accept;
                }
                return reject;
            }
            if (Editor.key-chord(event.text, event.modifiers.shift, event.modifiers.alt,
                    event.modifiers.control, event.modifiers.meta, root.on-start)) {
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            if !root.phone: TitleBar {
                macos: root.macos;
                minimal: root.on-start;
                deep: root.on-start;
                project-name: root.project-name;
                status: root.project-status;

                menu: root.open-menu;
                keyboard-menu: root.keyboard-menu;
                keyboard-token: root.keyboard-menu-token;
                menu-opened(index, at-x, keyboard) => {
                    appmenu.request-x = at-x + root.safe-area-insets.left;
                    appmenu.request-y = 36px + root.safe-area-insets.top;
                    root.menu-by-keyboard = keyboard;
                    root.menu-opened(index);
                }

                own-buttons: root.own-window-buttons;
                maximized: root.window-maximized;
                begin-drag => { root.titlebar-begin-drag(); }
                toggle-maximize => { root.titlebar-toggle-maximize(); }
                minimize => { root.titlebar-minimize(); }
                close => { root.titlebar-close(); }
                open-settings => { root.open-settings(); }
                add-pane(kind) => { Editor.dock-add(kind); }
                export-clicked => { root.export-clicked(); }
                go-home => { root.app-menu-selected("close-project"); }
                save-clicked => { root.app-menu-selected("save-project"); }
                undo-clicked => { root.app-menu-selected("undo"); }
                redo-clicked => { root.app-menu-selected("redo"); }
            }

            // Main Content + Docked Right AI Sidebar
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                if root.on-start: StartScreen {
                    horizontal-stretch: 1;

                    recents: root.recents;
                    recents-total: root.recents-total;
                    query: root.start.query;
                    sort: root.start.sort;
                    busy: root.start.busy;
                    phone: root.phone;
                    version: root.app-version;
                    can-drop: root.can-drop;

                    compose => { root.start-compose(); }
                    open => { root.start-open(); }
                    open-settings => { root.open-settings(); }
                    open-recent(path) => { root.start-open-recent(path); }
                    forget-recent(path) => { root.start-forget-recent(path); }
                    reveal-recent(path) => { root.start-reveal-recent(path); }
                    search-edited(query) => { root.start-search-edited(query); }
                    sort-changed(sort) => { root.start-sort-changed(sort); }
                    link(name) => { root.start-link(name); }
                }

                if !root.on-start && !root.phone: Workspace {
                    horizontal-stretch: 1;
                }

                if !root.on-start && root.phone: PhoneEditor {
                    horizontal-stretch: 1;
                    project-name: root.project-name;
                    status: root.project-status;

                    export-clicked => { root.export-clicked(); }
                    open-settings => { root.open-settings(); }
                    close-project => { root.app-menu-selected("close-project"); }
                }

                if Craft.ai-open && !root.phone: AiSidebar {}
            }

            // Unified 28px Bottom Footer with Theme Dropdown
            if !root.phone: CraftFooter {}
        }
    }

    if !root.on-start: VoiceoverPanel {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        phone: root.phone;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        data: root.voiceover;
        devices: root.voiceover-devices;
        level: Editor.record-level;
        rms: Editor.record-rms;
        clipped: Editor.record-clipped;
        seconds: Editor.record-seconds;
        silent: Editor.record-silent;

        closed => { root.voiceover-closed(); }
        action(verb) => { root.voiceover-action(verb); }
        device-changed(index) => { root.voiceover-device-changed(index); }
        countdown-changed(on) => { root.voiceover-countdown-changed(on); }
        mute-changed(on) => { root.voiceover-mute-changed(on); }
        gain-changed(db) => { root.voiceover-gain-changed(db); }
        prompt-edited(text) => { root.voiceover-prompt-edited(text); }
        prompt-speed-changed(index) => { root.voiceover-prompt-speed-changed(index); }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        z: root.sheets-fill ? 1 : 0;

        CaptionsDialog {
            fill: root.sheets-fill;
            floating: !root.sheets-fill;
            z: root.front-tool == "captions" ? 1 : 0;
            raised => { root.front-tool = "captions"; }
            inset-top: root.safe-area-insets.top;
            inset-bottom: root.safe-area-insets.bottom;
            inset-left: root.safe-area-insets.left;
            inset-right: root.safe-area-insets.right;
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            data: root.captions;
            models: root.caption-models;
            languages: root.caption-languages;

            closed => { root.captions-closed(); }
            voice-toggled(on) => { root.captions-voice-toggled(on); }
            source-changed(index) => { root.captions-source-changed(index); }
            text-edited(text) => { root.captions-text-edited(text); }
            model-changed(index) => { root.captions-model-changed(index); }
            language-changed(index) => { root.captions-language-changed(index); }
            placement-changed(index) => { root.captions-placement-changed(index); }
            size-changed(index) => { root.captions-size-changed(index); }
            begin => { root.captions-begin(); }
            cancel => { root.captions-cancel(); }
            import-srt => { root.captions-import-srt(); }
            export-srt => { root.captions-export-srt(); }
        }

        SpeechDialog {
            fill: root.sheets-fill;
            floating: !root.sheets-fill;
            home-right: 44px;
            home-top: 76px;
            z: root.front-tool == "speech" ? 1 : 0;
            raised => { root.front-tool = "speech"; }
            inset-top: root.safe-area-insets.top;
            inset-bottom: root.safe-area-insets.bottom;
            inset-left: root.safe-area-insets.left;
            inset-right: root.safe-area-insets.right;
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            data: root.speech;
            models: root.speech-models;
            model-details: root.speech-model-details;
            voices: root.speech-voices;
            voice-details: root.speech-voice-details;
            voice-avatars: root.speech-voice-avatars;
            samples: root.speech-samples;
            sample-waves: root.speech-sample-waves;
            sample-details: root.speech-sample-details;

            closed => { root.speech-closed(); }
            text-edited(text) => { root.speech-text-edited(text); }
            voice-changed(index) => { root.speech-voice-changed(index); }
            model-changed(index) => { root.speech-model-changed(index); }
            speed-changed(value) => { root.speech-speed-changed(value); }
            quality-changed(index) => { root.speech-quality-changed(index); }
            pauses-changed(value) => { root.speech-pauses-changed(value); }
            reference-start-changed(seconds) => { root.speech-reference-start-changed(seconds); }
            use-sample-changed(on) => { root.speech-use-sample-changed(on); }
            sample-changed(index) => { root.speech-sample-changed(index); }
            insert-tag(text, tag, at) => { return root.speech-insert-tag(text, tag, at); }
            begin => { root.speech-begin(); }
            cancel => { root.speech-cancel(); }
            save-name-edited(name) => { root.speech-save-name-edited(name); }
            pick-picture => { root.speech-pick-picture(); }
            save-voice => { root.speech-save-voice(); }
            clear-style => { root.speech-clear-style(); }
        }
    }

    NewProjectDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.start;
        phone: root.phone;
        aspects: root.start-aspects;
        sizes: root.start-sizes;
        rates: root.start-rates;

        closed => { root.start-dismiss(); }
        name-edited(name) => { root.start-name-edited(name); }
        location-edited(path) => { root.start-location-edited(path); }
        browse => { root.start-browse(); }
        aspect-changed(index) => { root.start-aspect-changed(index); }
        size-changed(index) => { root.start-size-changed(index); }
        rate-changed(index) => { root.start-rate-changed(index); }
        custom-width-edited(width) => { root.start-custom-width-edited(width); }
        custom-height-edited(height) => { root.start-custom-height-edited(height); }
        custom-fps-edited(fps) => { root.start-custom-fps-edited(fps); }
        canvas-changed(value) => { root.start-canvas-changed(value); }
        create => { root.start-create(); }
        dismiss-error => { root.start-dismiss-error(); }
    }

    ExportDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        phone: root.phone;
        data: root.export;
        preview-frame: Editor.preview-frame;
        playhead: Editor.playhead;
        duration-seconds: Editor.duration-seconds;
        frame-rate: Editor.frame-rate;
        seek(seconds) => { Editor.seek(seconds); }

        closed => { root.export-closed(); }
        name-edited(name) => { root.export-name-edited(name); }
        browse => { root.export-browse(); }
        rate-changed(index) => { root.export-rate-changed(index); }
        codec-changed(index) => { root.export-codec-changed(index); }
        ten-bit-changed(on) => { root.export-ten-bit-changed(on); }
        hdr-changed(on) => { root.export-hdr-changed(on); }
        bitrate-changed(mbps) => { root.export-bitrate-changed(mbps); }
        begin => { root.export-start(); }
        cancel => { root.export-cancel(); }
        reveal => { root.export-reveal(); }
        again => { root.export-again(); }
    }

    SettingsDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        phone: root.phone;
        data: root.settings;
        transcribers: root.transcribers;
        voices: root.voices;
        versions: root.versions;
        version-details: root.version-details;
        languages: root.languages;
        system-facts: root.system-facts;
        system-report: root.system-report;
        on-start: root.on-start;

        focus-keys => { keys.focus(); }
        closed => { root.settings-closed(); }
        page-changed(index) => { root.settings-page-changed(index); }
        shortcut-capture(id) => { root.settings-shortcut-capture(id); }
        shortcut-reset(id) => { root.settings-shortcut-reset(id); }
        shortcut-reset-all => { root.settings-shortcut-reset-all(); }
        show-log => { root.settings-show-log(); }
        language-changed(index) => { root.settings-language-changed(index); }
        log-level-changed(index) => { root.settings-log-level-changed(index); }
        theme-changed(dark) => { root.settings-theme-changed(dark); }
        accent-changed(index) => { root.settings-accent-changed(index); }
        accent-custom-changed(colour) => { root.settings-accent-custom-changed(colour); }
        playhead-changed(colour) => { root.settings-playhead-changed(colour); }
        playhead-chosen(index) => { root.settings-playhead-chosen(index); }
        scale-changed(index) => { root.settings-scale-changed(index); }
        playhead-stops-changed(on) => { root.settings-playhead-stops-changed(on); }
        proxies-changed(on) => { root.settings-proxies-changed(on); }
        gpu-changed(on) => { root.settings-gpu-changed(on); }
        magnetic-changed(on) => { root.settings-magnetic-changed(on); }
        download-source-changed(index) => { root.settings-download-source-changed(index); }
        download-base-edited(text) => { root.settings-download-base-edited(text); }
        server-enabled-changed(on) => { root.settings-server-enabled-changed(on); }
        server-host-edited(text) => { root.settings-server-host-edited(text); }
        server-port-edited(port) => { root.settings-server-port-edited(port); }
        server-token-edited(text) => { root.settings-server-token-edited(text); }
        server-token-generated => { root.settings-server-token-generated(); }
        check-updates => { root.settings-check-updates(); }
        version-chosen(index) => { root.settings-version-chosen(index); }
        install-version => { root.settings-install-version(); }
        install-cancel => { root.settings-install-cancel(); }
        model-activated(id) => { root.model-activated(id); }
        model-download(id) => { root.model-download(id); }
        model-cancel(id) => { root.model-cancel(id); }
        model-remove(id) => { root.model-remove(id); }
        model-open-link(id) => { root.model-open-link(id); }
        model-choose-file(id) => { root.model-choose-file(id); }
    }

    in property <RelinkData> relink;
    callback relink-all();
    callback relink-dismiss();

    ProjectDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.project-sheet;

        closed => { root.project-closed(); }
        name-edited(name) => { root.project-name-edited(name); }
        size-changed(index) => { root.project-size-changed(index); }
        rate-changed(index) => { root.project-rate-changed(index); }
        custom-width-edited(width) => { root.project-custom-width-edited(width); }
        custom-height-edited(height) => { root.project-custom-height-edited(height); }
        custom-fps-edited(fps) => { root.project-custom-fps-edited(fps); }
        color-space-changed(index) => { root.project-color-space-changed(index); }
        canvas-changed(value) => { root.project-canvas-changed(value); }
        apply => { root.project-apply(); }
    }

    NewVoiceDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.new-voice;

        closed => { root.new-voice-closed(); }
        name-edited(name) => { root.new-voice-name-edited(name); }
        description-edited(text) => { root.new-voice-description-edited(text); }
        start-changed(seconds) => { root.new-voice-start-changed(seconds); }
        pick-picture => { root.new-voice-pick-picture(); }
        save => { root.new-voice-save(); }
    }

    RelinkDialog {
        fill: root.sheets-fill;
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        data: root.relink;
        relink-all => { root.relink-all(); }
        dismiss => { root.relink-dismiss(); }
    }

    in property <ConfirmData> confirm;
    callback confirm-accepted();
    callback confirm-dismissed();

    ConfirmDialog {
        inset-top: root.safe-area-insets.top;
        inset-bottom: root.safe-area-insets.bottom;
        inset-left: root.safe-area-insets.left;
        inset-right: root.safe-area-insets.right;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.confirm;
        confirmed => { root.confirm-accepted(); }
        dismissed => { root.confirm-dismissed(); }
    }

    // Footer Theme Dropdown Popover
    FooterThemePopover {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // BYOK API Manager Modal
    ApiManagerModal {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    TooltipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    appmenu := ContextMenu {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        items: root.app-menu-items;
        menu-height: root.app-menu-height;
        token: root.app-menu-token;
        keyboard: root.menu-by-keyboard;
        selected(id) => { root.app-menu-selected(id); }
        neighbour(by) => { root.open-menu-from-keys(Math.mod(root.open-menu + by, 3)); }
    }

    ToastLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        data: root.toast;
    }
}
